# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Keep out of the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Secret token gating the public iCalendar feed at /api/calendar/tutor.ics -
# treat this like a password; anyone with it can read the tutor's schedule.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TUTOR_CALENDAR_FEED_TOKEN=

# Edge Function only (AI lesson-summary drafting).
ANTHROPIC_API_KEY=

# Web Push (VAPID keypair - generate with `npx web-push generate-vapid-keys`).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
